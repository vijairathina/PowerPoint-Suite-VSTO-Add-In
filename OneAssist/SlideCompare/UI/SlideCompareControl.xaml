<UserControl x:Class="OneAssist.SlideCompare.UI.SlideCompareControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OneAssist.SlideCompare.UI"
             xmlns:models="clr-namespace:OneAssist.SlideCompare.Models"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="460"
             Background="#202020" Foreground="#F3F3F3"
             FontFamily="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <local:SlideStatusColorConverter x:Key="SlideColorConv" />
        <local:ShapeStatusColorConverter x:Key="ShapeColorConv" />

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2E2E2E"/>
            <Setter Property="Foreground" Value="#F3F3F3"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D3D3D"/>
                    <Setter Property="BorderBrush" Value="#555555"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#D24726"/>
            <Setter Property="BorderBrush" Value="#E05B3B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B83B1B"/>
                    <Setter Property="BorderBrush" Value="#F07050"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Source & Destination Selection -->
            <RowDefinition Height="Auto"/>
            <!-- Progress Bar (Visible when busy) -->
            <RowDefinition Height="Auto"/>
            <!-- Summary Dashboard -->
            <RowDefinition Height="Auto"/>
            <!-- Filter & Search Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Results Tree/List -->
            <RowDefinition Height="*"/>
            <!-- Bottom Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header (Icon-only action buttons: Files, Restore View, Settings) -->
        <Border Grid.Row="0" Margin="0,0,0,12" BorderBrush="#383838" BorderThickness="0,0,0,1" Padding="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="18" Margin="0,0,6,0" Foreground="#D24726"/>
                        <TextBlock Text="PowerPoint-Suite" FontSize="16" FontWeight="Bold" Foreground="#F3F3F3"/>
                        <TextBlock Text=" | Slide Compare" FontSize="13" FontWeight="SemiBold" Foreground="#A6A6A6" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Intelligent Content &amp; Difference Analysis" FontSize="11" Foreground="#A6A6A6" Margin="24,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Files Toggle Button (Only Icon) -->
                    <Button Style="{StaticResource IconButton}" Command="{Binding ToggleFilesVisibilityCommand}" ToolTip="{Binding FilesButtonTooltip}" Margin="0,0,5,0"
                            Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="📁" FontSize="13" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <!-- Maximize / Restore Button (Only Icon) -->
                    <Button Style="{StaticResource IconButton}" Command="{Binding ToggleMaximizeResultsCommand}" ToolTip="{Binding MaximizeButtonTooltip}" Margin="0,0,5,0"
                            Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding MaximizeButtonIcon}" FontSize="13" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <!-- Settings Button (Only Icon) -->
                    <Button Style="{StaticResource IconButton}" Command="{Binding ToggleSettingsCommand}" ToolTip="Comparison Settings" Margin="0,0,0,0">
                        <TextBlock Text="⚙" FontSize="14" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Source & Destination Card (Auto-hidden once compare runs, toggleable via Files button) -->
        <Border Grid.Row="1" Background="#2B2B2B" CornerRadius="6" BorderBrush="#383838" BorderThickness="1" Padding="12" Margin="0,0,0,10"
                Visibility="{Binding IsFilesSectionVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Vertical">
                <!-- Header with Hide button -->
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="PRESENTATIONS" FontSize="10" FontWeight="Bold" Foreground="#888888" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource ModernButton}" Command="{Binding ToggleFilesVisibilityCommand}" Content="▲ Hide" FontSize="10" Padding="6,2" HorizontalAlignment="Right" ToolTip="Hide file panel to maximize results area"/>
                </Grid>

                <!-- Destination -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Destination:" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" Width="75" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding DestinationPresentationName}" FontSize="12" Foreground="#F3F3F3" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!-- Source File -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Source:" FontSize="11" FontWeight="SemiBold" Foreground="#A6A6A6" Width="75" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding SourceFileName}" ToolTip="{Binding SourceFilePath}" FontSize="12" Foreground="#CCCCCC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="2" Style="{StaticResource ModernButton}" Command="{Binding BrowseSourceCommand}" Padding="8,4" Content="Browse..." FontSize="11" Margin="6,0,0,0"/>
                </Grid>

                <!-- Compare Action Button -->
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartCompareCommand}" Height="34" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▶" Margin="0,0,8,0"/>
                        <TextBlock Text="Run Intelligent Compare"/>
                    </StackPanel>
                </Button>

                <!-- Settings Expander Flyout -->
                <Border Margin="0,10,0,0" Padding="10" Background="#202020" CornerRadius="4" BorderBrush="#3E3E3E" BorderThickness="1"
                        Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Comparison Settings" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,8"/>
                        <UniformGrid Columns="2">
                            <CheckBox Content="Compare Text" IsChecked="{Binding Settings.CompareText}" Foreground="#CCCCCC" Margin="0,3"/>
                            <CheckBox Content="Compare Shapes" IsChecked="{Binding Settings.CompareShapes}" Foreground="#CCCCCC" Margin="0,3"/>
                            <CheckBox Content="Compare Tables" IsChecked="{Binding Settings.CompareTables}" Foreground="#CCCCCC" Margin="0,3"/>
                            <CheckBox Content="Compare Charts" IsChecked="{Binding Settings.CompareCharts}" Foreground="#CCCCCC" Margin="0,3"/>
                            <CheckBox Content="Compare Images" IsChecked="{Binding Settings.CompareImages}" Foreground="#CCCCCC" Margin="0,3"/>
                            <CheckBox Content="Compare Formatting" IsChecked="{Binding Settings.CompareFormatting}" Foreground="#CCCCCC" Margin="0,3"/>
                            <CheckBox Content="Compare Position" IsChecked="{Binding Settings.ComparePosition}" Foreground="#CCCCCC" Margin="0,3"/>
                            <CheckBox Content="Speaker Notes" IsChecked="{Binding Settings.CompareSpeakerNotes}" Foreground="#CCCCCC" Margin="0,3"/>
                            <CheckBox Content="Hidden Slides" IsChecked="{Binding Settings.CompareHiddenSlides}" Foreground="#CCCCCC" Margin="0,3"/>
                        </UniformGrid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Threshold:" FontSize="11" Foreground="#A6A6A6" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0.4" Maximum="0.95" Value="{Binding Settings.SimilarityThreshold}" Margin="8,0" SmallChange="0.05"/>
                            <TextBlock Grid.Column="2" Text="{Binding Settings.SimilarityThreshold, StringFormat={}{0:P0}}" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 3. Progress Bar -->
        <Border Grid.Row="2" Background="#2B2B2B" CornerRadius="4" Padding="10" Margin="0,0,0,10"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Vertical">
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="#38BDF8"/>
                    <Button Style="{StaticResource ModernButton}" Command="{Binding CancelCompareCommand}" Content="Cancel" HorizontalAlignment="Right" Padding="6,2" FontSize="10"/>
                </Grid>
                <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressPercentage}" Foreground="#38BDF8" Background="#1C1C1C"/>
            </StackPanel>
        </Border>

        <!-- 4a. Interactive Summary Dashboard (Expanded View) -->
        <Border Grid.Row="3" Background="#2B2B2B" CornerRadius="6" BorderBrush="#383838" BorderThickness="1" Padding="8" Margin="0,0,0,10"
                Visibility="{Binding IsSummarySectionExpanded, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Vertical">
                <Grid Margin="4,0,4,6">
                    <TextBlock Text="SUMMARY" FontSize="11" FontWeight="Bold" Foreground="#888888" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalIssuesCount, StringFormat={}{0} Differences}" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource ModernButton}" Command="{Binding ToggleSummarySectionCommand}" Content="▲ Hide" FontSize="10" Padding="6,2" ToolTip="Collapse summary dashboard"/>
                    </StackPanel>
                </Grid>
                <UniformGrid Columns="4" Rows="2">
                    <!-- Matched -->
                    <Button Style="{StaticResource ModernButton}" Command="{Binding SetFilterCommand}" CommandParameter="Matched" Margin="2" Padding="4" ToolTip="{Binding SummaryMatchedTooltip}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SummaryMatched, StringFormat={}✓ {0}}" FontSize="13" FontWeight="Bold" Foreground="#22C55E" HorizontalAlignment="Center"/>
                            <TextBlock Text="Matched" FontSize="10" Foreground="#A6A6A6" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Modified -->
                    <Button Style="{StaticResource ModernButton}" Command="{Binding SetFilterCommand}" CommandParameter="Modified" Margin="2" Padding="4" ToolTip="Modified slides and content">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SummaryModified, StringFormat={}✎ {0}}" FontSize="13" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                            <TextBlock Text="Modified" FontSize="10" Foreground="#A6A6A6" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Added -->
                    <Button Style="{StaticResource ModernButton}" Command="{Binding SetFilterCommand}" CommandParameter="Added" Margin="2" Padding="4" ToolTip="Added slides and shapes">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SummaryAdded, StringFormat={}+ {0}}" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                            <TextBlock Text="Added" FontSize="10" Foreground="#A6A6A6" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Deleted -->
                    <Button Style="{StaticResource ModernButton}" Command="{Binding SetFilterCommand}" CommandParameter="Deleted" Margin="2" Padding="4" ToolTip="Deleted slides and shapes">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SummaryDeleted, StringFormat={}− {0}}" FontSize="13" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center"/>
                            <TextBlock Text="Deleted" FontSize="10" Foreground="#A6A6A6" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Moved -->
                    <Button Style="{StaticResource ModernButton}" Command="{Binding SetFilterCommand}" CommandParameter="Moved" Margin="2" Padding="4" ToolTip="Moved slides and shapes">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SummaryMoved, StringFormat={}↔ {0}}" FontSize="13" FontWeight="Bold" Foreground="#FBBF24" HorizontalAlignment="Center"/>
                            <TextBlock Text="Moved" FontSize="10" Foreground="#A6A6A6" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Reordered -->
                    <Button Style="{StaticResource ModernButton}" Command="{Binding SetFilterCommand}" CommandParameter="Reordered" Margin="2" Padding="4" ToolTip="Reordered slides">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SummaryReordered, StringFormat={}⇄ {0}}" FontSize="13" FontWeight="Bold" Foreground="#FBBF24" HorizontalAlignment="Center"/>
                            <TextBlock Text="Reordered" FontSize="10" Foreground="#A6A6A6" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Split -->
                    <Button Style="{StaticResource ModernButton}" Command="{Binding SetFilterCommand}" CommandParameter="Split" Margin="2" Padding="4" ToolTip="Split slides">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SummarySplit, StringFormat={}⇢ {0}}" FontSize="13" FontWeight="Bold" Foreground="#06B6D4" HorizontalAlignment="Center"/>
                            <TextBlock Text="Split" FontSize="10" Foreground="#A6A6A6" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Merged -->
                    <Button Style="{StaticResource ModernButton}" Command="{Binding SetFilterCommand}" CommandParameter="Merged" Margin="2" Padding="4" ToolTip="Merged slides">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SummaryMerged, StringFormat={}⇠ {0}}" FontSize="13" FontWeight="Bold" Foreground="#EC4899" HorizontalAlignment="Center"/>
                            <TextBlock Text="Merged" FontSize="10" Foreground="#A6A6A6" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- 4b. Interactive Summary Dashboard (Collapsed Compact Bar) -->
        <Border Grid.Row="3" Background="#2B2B2B" CornerRadius="4" BorderBrush="#383838" BorderThickness="1" Padding="6,3" Margin="0,0,0,8"
                Visibility="{Binding IsSummarySectionCollapsed, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ModernButton}" Command="{Binding SetFilterCommand}" CommandParameter="Matched" Padding="5,2" Margin="2,0" ToolTip="{Binding SummaryMatchedTooltip}">
                        <TextBlock Text="{Binding SummaryMatched, StringFormat={}✓ {0}}" FontSize="10" FontWeight="Bold" Foreground="#22C55E"/>
                    </Button>
                    <Button Style="{StaticResource ModernButton}" Command="{Binding SetFilterCommand}" CommandParameter="Modified" Padding="5,2" Margin="2,0" ToolTip="Modified">
                        <TextBlock Text="{Binding SummaryModified, StringFormat={}✎ {0}}" FontSize="10" FontWeight="Bold" Foreground="#F59E0B"/>
                    </Button>
                    <Button Style="{StaticResource ModernButton}" Command="{Binding SetFilterCommand}" CommandParameter="Added" Padding="5,2" Margin="2,0" ToolTip="Added">
                        <TextBlock Text="{Binding SummaryAdded, StringFormat={}+ {0}}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                    </Button>
                    <Button Style="{StaticResource ModernButton}" Command="{Binding SetFilterCommand}" CommandParameter="Deleted" Padding="5,2" Margin="2,0" ToolTip="Deleted">
                        <TextBlock Text="{Binding SummaryDeleted, StringFormat={}− {0}}" FontSize="10" FontWeight="Bold" Foreground="#EF4444"/>
                    </Button>
                    <Button Style="{StaticResource ModernButton}" Command="{Binding SetFilterCommand}" CommandParameter="Moved" Padding="5,2" Margin="2,0" ToolTip="Moved">
                        <TextBlock Text="{Binding SummaryMoved, StringFormat={}↔ {0}}" FontSize="10" FontWeight="Bold" Foreground="#FBBF24"/>
                    </Button>
                </WrapPanel>
                <Button Grid.Column="1" Style="{StaticResource ModernButton}" Command="{Binding ToggleSummarySectionCommand}" Content="▼ Show Summary" FontSize="10" Padding="6,2"/>
            </Grid>
        </Border>

        <!-- 5. Search & Filter Bar (Fast Debounced Search with Search Icon & Clear Button) -->
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Search Box with Search Icon and Clear Button -->
            <Border Background="#1C1C1C" CornerRadius="4" BorderBrush="#3E3E3E" BorderThickness="1" Padding="8,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Background="Transparent" Foreground="#F3F3F3" BorderThickness="0" 
                             CaretBrush="#F3F3F3" VerticalAlignment="Center" FontSize="12">
                        <TextBox.ToolTip>Search slide numbers, shape names, and text content...</TextBox.ToolTip>
                    </TextBox>
                    <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" 
                            Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVis}}"
                            Background="Transparent" BorderThickness="0" Foreground="#888888" 
                            Cursor="Hand" Padding="4,0" Content="✕" FontSize="11" ToolTip="Clear search">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#F3F3F3"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
            <!-- Show Issues Only Checkbox -->
            <CheckBox Grid.Column="1" Content="Issues only" IsChecked="{Binding ShowOnlyIssues}" Foreground="#A6A6A6" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"/>
        </Grid>

        <!-- 6. Results List / Tree -->
        <Border Grid.Row="5" Background="#262626" CornerRadius="6" BorderBrush="#383838" BorderThickness="1" Padding="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding FilteredResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Slide Expander Card -->
                            <Border Background="#202020" CornerRadius="4" BorderBrush="{Binding MatchType, Converter={StaticResource SlideColorConv}}" BorderThickness="2,0,0,0" Margin="4,4,4,6" Padding="8">
                                <StackPanel Orientation="Vertical">
                                    <!-- Slide Header Row -->
                                    <Grid Cursor="Hand">
                                        <Grid.InputBindings>
                                            <MouseBinding Gesture="LeftClick" 
                                                          Command="{Binding DataContext.NavigateToSlideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                          CommandParameter="{Binding}"/>
                                        </Grid.InputBindings>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StatusIcon}" Foreground="{Binding MatchType, Converter={StaticResource SlideColorConv}}" FontWeight="Bold" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TitleDisplay}" FontWeight="SemiBold" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="2" Background="#2E2E2E" CornerRadius="3" Padding="6,2">
                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{Binding MatchType, Converter={StaticResource SlideColorConv}}"/>
                                        </Border>
                                    </Grid>

                                    <!-- Slide Summary Text -->
                                    <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="#A6A6A6" Margin="20,2,0,4"/>

                                    <!-- Speaker Notes Diff if any -->
                                    <Border Visibility="{Binding SpeakerNotesDiff, Converter={StaticResource BoolToVis}}" Background="#2B2B2B" CornerRadius="4" Padding="6" Margin="20,2,0,4">
                                        <TextBlock Text="{Binding SpeakerNotesDiff, StringFormat={}Notes: {0}}" FontSize="11" Foreground="#CCCCCC" TextWrapping="Wrap"/>
                                    </Border>

                                    <!-- Child Shape Differences -->
                                    <ItemsControl ItemsSource="{Binding DisplayShapes}" Margin="16,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#272727" CornerRadius="4" Padding="8" Margin="0,3,0,4" BorderBrush="#383838" BorderThickness="1" Cursor="Hand">
                                                    <Border.InputBindings>
                                                        <MouseBinding Gesture="LeftClick" 
                                                                      Command="{Binding DataContext.NavigateToShapeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                      CommandParameter="{Binding}"/>
                                                    </Border.InputBindings>
                                                    <StackPanel Orientation="Vertical">
                                                        <!-- Shape Title & Status Badge -->
                                                        <Grid Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding StatusIcon}" Foreground="{Binding MatchType, Converter={StaticResource ShapeColorConv}}" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="#F3F3F3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <Border Grid.Column="2" Background="#1E1E1E" CornerRadius="3" Padding="6,2">
                                                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{Binding MatchType, Converter={StaticResource ShapeColorConv}}"/>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Details note if any -->
                                                        <TextBlock Text="{Binding Details}" FontSize="10" Foreground="#888888" Margin="18,0,0,4"/>

                                                        <!-- MODIFIED CONTENT: Full Source vs Destination & Difference Display -->
                                                        <Border Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}" Background="#1E1E1E" CornerRadius="4" BorderBrush="#383838" BorderThickness="1" Padding="8" Margin="0,2,0,4">
                                                            <StackPanel Orientation="Vertical">
                                                                <!-- Source Text -->
                                                                <Grid Visibility="{Binding HasSourceText, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Background="#3D1414" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Top">
                                                                        <TextBlock Text="SOURCE" FontSize="9" FontWeight="Bold" Foreground="#F87171"/>
                                                                    </Border>
                                                                    <TextBlock Grid.Column="1" Text="{Binding SourceText}" FontSize="11" Foreground="#CCCCCC" TextWrapping="Wrap"/>
                                                                </Grid>

                                                                <!-- Destination Text -->
                                                                <Grid Visibility="{Binding HasDestinationText, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Background="#123020" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Top">
                                                                        <TextBlock Text="DEST" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                                                                    </Border>
                                                                    <TextBlock Grid.Column="1" Text="{Binding DestinationText}" FontSize="11" Foreground="#F3F3F3" TextWrapping="Wrap"/>
                                                                </Grid>

                                                                <!-- Inline Rich Text Diff Highlight (Red strikethrough = deleted, Blue = inserted, Yellow = moved) -->
                                                                <Border Visibility="{Binding HasTextChanges, Converter={StaticResource BoolToVis}}" Background="#161616" CornerRadius="4" BorderBrush="#383838" BorderThickness="1" Padding="8" Margin="0,3,0,0">
                                                                    <StackPanel Orientation="Vertical">
                                                                        <Grid Margin="0,0,0,5">
                                                                            <TextBlock Text="DIFFERENCE:" FontSize="9" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                                <TextBlock Text="Deleted" FontSize="9" Foreground="#EF4444" TextDecorations="Strikethrough" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                                                <TextBlock Text="Inserted" FontSize="9" Foreground="#38BDF8" FontWeight="Bold" Margin="0,0,8,0"/>
                                                                                <TextBlock Text="Moved" FontSize="9" Foreground="#FBBF24" FontWeight="SemiBold"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                        <!-- Rich inline diff with Strikethrough Red (deleted), Blue (inserted), and Yellow (moved) -->
                                                                        <TextBlock local:DiffTextBlockHelper.DiffTokens="{Binding DiffTokens}"
                                                                                   FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif" 
                                                                                   FontSize="12" 
                                                                                   LineHeight="18"
                                                                                   TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- DELETED CONTENT: Shows source text that was removed (Strikethrough & Red) -->
                                                        <Border Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVis}}" Background="#331414" CornerRadius="4" BorderBrush="#5C2020" BorderThickness="1" Padding="8" Margin="0,2,0,4">
                                                            <StackPanel Orientation="Vertical">
                                                                <TextBlock Text="DELETED FROM DESTINATION:" FontSize="9" FontWeight="Bold" Foreground="#EF4444" Margin="0,0,0,3"/>
                                                                <TextBlock Text="{Binding SourceText}" FontSize="11" Foreground="#EF4444" TextDecorations="Strikethrough" FontWeight="Medium" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- INSERTED CONTENT: Shows new destination text (Blue) -->
                                                        <Border Visibility="{Binding IsAdded, Converter={StaticResource BoolToVis}}" Background="#102538" CornerRadius="4" BorderBrush="#1C4B75" BorderThickness="1" Padding="8" Margin="0,2,0,4">
                                                            <StackPanel Orientation="Vertical">
                                                                <TextBlock Text="INSERTED IN DESTINATION:" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,3"/>
                                                                <TextBlock Text="{Binding DestinationText}" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- MATCHED CONTENT: Shows text preview when shape is matched -->
                                                        <Border Visibility="{Binding IsMatched, Converter={StaticResource BoolToVis}}" Background="#1E1E1E" CornerRadius="4" BorderBrush="#333333" BorderThickness="1" Padding="8" Margin="0,2,0,4">
                                                            <TextBlock Text="{Binding DestinationText}" FontSize="11" Foreground="#888888" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                                        </Border>

                                                        <!-- Position Diff Display (Moved in Yellow) -->
                                                        <Border Visibility="{Binding HasPositionDiff, Converter={StaticResource BoolToVis}}" Background="#2E2410" CornerRadius="4" Padding="6,3" Margin="0,3,0,2" BorderBrush="#6E5416" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="↔ MOVED: " FontSize="10" FontWeight="Bold" Foreground="#FBBF24"/>
                                                                <TextBlock Text="{Binding PositionDiff}" FontSize="10" Foreground="#FDE68A" FontWeight="Medium"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Formatting Details List -->
                                                        <ItemsControl ItemsSource="{Binding FormattingDifferences}" Margin="0,2,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}" FontSize="10" Foreground="#F59E0B" Margin="0,1"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 7. Bottom Action Bar -->
        <Border Grid.Row="6" Margin="0,8,0,0" BorderBrush="#383838" BorderThickness="0,1,0,0" Padding="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Click any item to navigate slide in PowerPoint" FontSize="10" Foreground="#888888" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource ModernButton}" Command="{Binding ExportHtmlCommand}" Content="Export HTML" FontSize="11" Margin="6,0,0,0" Padding="12,4"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
