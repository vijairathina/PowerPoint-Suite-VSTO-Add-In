<UserControl x:Class="OneAssist.Assistant.UI.DesignAssistantControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OneAssist.Assistant.UI"
             xmlns:core="clr-namespace:OneAssist.Assistant.Core"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="450"
             FontFamily="Segoe UI" FontSize="12" Background="#F8F9FA">

    <UserControl.Resources>
        <local:SeverityToColorConverter x:Key="SeverityToColorConv" />
        <local:HealthScoreToColorConverter x:Key="HealthScoreToColorConv" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConv" />

        <Style x:Key="TabHeaderBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,2.5" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0284C7" />
                                <Setter Property="Foreground" Value="#0284C7" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#0369A1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeToggleBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="1,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0284C7" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Mode Switcher -->
            <RowDefinition Height="Auto" /> <!-- Context Awareness Ribbon -->
            <RowDefinition Height="Auto" /> <!-- Navigation Tabs (Designer/Expert) -->
            <RowDefinition Height="*" />    <!-- Content Area -->
            <RowDefinition Height="Auto" /> <!-- Status Footer -->
        </Grid.RowDefinitions>

        <!-- ── HEADER & MODE SWITCHER ── -->
        <Border Grid.Row="0" Background="#0F172A" Padding="14,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="OneAssist Studio" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" />
                            <TextBlock Text=" • Pro" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12" Margin="4,1,0,0" />
                        </StackPanel>
                        <TextBlock Text="Designer • Consistency • Quality Control" Foreground="#94A3B8" FontSize="10.5" />
                    </StackPanel>

                    <!-- Segmented Mode Switcher (Req 49, 50, 51) -->
                    <Border Grid.Column="1" Background="#0B1120" CornerRadius="6" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="💼 Business" Style="{StaticResource ModeToggleBtn}" Tag="BusinessUser" IsChecked="{Binding CurrentMode, Converter={local:ModeToBoolConverter}, ConverterParameter=BusinessUser}" Click="ModeClick" ToolTip="Simplified 7-button productivity dashboard" />
                            <RadioButton Content="🎨 Designer" Style="{StaticResource ModeToggleBtn}" Tag="Designer" IsChecked="{Binding CurrentMode, Converter={local:ModeToBoolConverter}, ConverterParameter=Designer}" Click="ModeClick" ToolTip="Precision design, layout, grid, and consistency tools" />
                            <RadioButton Content="⚡ Expert" Style="{StaticResource ModeToggleBtn}" Tag="Expert" IsChecked="{Binding CurrentMode, Converter={local:ModeToBoolConverter}, ConverterParameter=Expert}" Click="ModeClick" ToolTip="Tokens, declarative rule editor, and PowerPoint diagnostics" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Deck Metadata Bar (Req 59) -->
                <Border Background="#1E293B" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📄 " FontSize="11" />
                            <TextBlock Text="{Binding ActivePresentationName}" Foreground="#F1F5F9" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                            <TextBlock Text="  •  Slides: " Foreground="#94A3B8" FontSize="11" />
                            <TextBlock Text="{Binding SlideCount}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" />
                        </StackPanel>
                        <Border Grid.Column="2" Background="{Binding HealthScoreValue, Converter={StaticResource HealthScoreToColorConv}}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HealthScoreText, StringFormat='Health: {0}'}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10.5" />
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ── CONTEXT-AWARE SELECTION RIBBON (Req 58) ── -->
        <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="0,0,0,1" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SelectionContextText}" Foreground="#1D4ED8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="⚡ Make Slide Consistent" Style="{StaticResource PrimaryActionBtn}" Command="{Binding MakeSlideConsistentCommand}" FontSize="10" Padding="8,3" />
            </Grid>
        </Border>

        <!-- ── NAVIGATION TABS (Designer & Expert Modes) ── -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Visibility="{Binding CurrentMode, Converter={local:ModeToVisibilityConverter}, ConverterParameter='!BusinessUser'}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Margin="2,0">
                    <RadioButton Content="🏠 HOME" Style="{StaticResource TabHeaderBtn}" IsChecked="{Binding SelectedTabIndex, Converter={local:IntToBoolConverter}, ConverterParameter=0}" Click="TabClick" Tag="0" />
                    <RadioButton Content="📐 DESIGN" Style="{StaticResource TabHeaderBtn}" IsChecked="{Binding SelectedTabIndex, Converter={local:IntToBoolConverter}, ConverterParameter=1}" Click="TabClick" Tag="1" />
                    <RadioButton Content="🔤 FORMAT" Style="{StaticResource TabHeaderBtn}" IsChecked="{Binding SelectedTabIndex, Converter={local:IntToBoolConverter}, ConverterParameter=2}" Click="TabClick" Tag="2" />
                    <RadioButton Content="🎨 COLOR" Style="{StaticResource TabHeaderBtn}" IsChecked="{Binding SelectedTabIndex, Converter={local:IntToBoolConverter}, ConverterParameter=3}" Click="TabClick" Tag="3" />
                    <RadioButton Content="📏 LAYOUT" Style="{StaticResource TabHeaderBtn}" IsChecked="{Binding SelectedTabIndex, Converter={local:IntToBoolConverter}, ConverterParameter=4}" Click="TabClick" Tag="4" />
                    <RadioButton Content="📑 CONTENT" Style="{StaticResource TabHeaderBtn}" IsChecked="{Binding SelectedTabIndex, Converter={local:IntToBoolConverter}, ConverterParameter=5}" Click="TabClick" Tag="5" />
                    <RadioButton Content="📝 EDITORIAL" Style="{StaticResource TabHeaderBtn}" IsChecked="{Binding SelectedTabIndex, Converter={local:IntToBoolConverter}, ConverterParameter=6}" Click="TabClick" Tag="6" />
                    <RadioButton Content="🔍 QUALITY" Style="{StaticResource TabHeaderBtn}" IsChecked="{Binding SelectedTabIndex, Converter={local:IntToBoolConverter}, ConverterParameter=7}" Click="TabClick" Tag="7" />
                    <RadioButton Content="♿ ACCESSIBILITY" Style="{StaticResource TabHeaderBtn}" IsChecked="{Binding SelectedTabIndex, Converter={local:IntToBoolConverter}, ConverterParameter=8}" Click="TabClick" Tag="8" />
                    <RadioButton Content="✨ ANIMATION" Style="{StaticResource TabHeaderBtn}" IsChecked="{Binding SelectedTabIndex, Converter={local:IntToBoolConverter}, ConverterParameter=9}" Click="TabClick" Tag="9" />
                    <RadioButton Content="🗃️ ASSETS" Style="{StaticResource TabHeaderBtn}" IsChecked="{Binding SelectedTabIndex, Converter={local:IntToBoolConverter}, ConverterParameter=10}" Click="TabClick" Tag="10" />
                    <RadioButton Content="🧹 CLEANUP" Style="{StaticResource TabHeaderBtn}" IsChecked="{Binding SelectedTabIndex, Converter={local:IntToBoolConverter}, ConverterParameter=11}" Click="TabClick" Tag="11" />
                    <RadioButton Content="⚙️ SETTINGS" Style="{StaticResource TabHeaderBtn}" IsChecked="{Binding SelectedTabIndex, Converter={local:IntToBoolConverter}, ConverterParameter=12}" Click="TabClick" Tag="12" />
                    <RadioButton Content="⚡ EXPERT" Style="{StaticResource TabHeaderBtn}" IsChecked="{Binding SelectedTabIndex, Converter={local:IntToBoolConverter}, ConverterParameter=13}" Click="TabClick" Tag="13" Visibility="{Binding CurrentMode, Converter={local:ModeToVisibilityConverter}, ConverterParameter=Expert}" />
                    <RadioButton Content="✨ AI LAYOUT" Style="{StaticResource TabHeaderBtn}" IsChecked="{Binding SelectedTabIndex, Converter={local:IntToBoolConverter}, ConverterParameter=14}" Click="TabClick" Tag="14" Foreground="#7C3AED" FontWeight="Bold" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ── MAIN CONTENT WORKSPACE ── -->
        <Grid Grid.Row="3" Margin="10">

            <!-- ======================================================== -->
            <!-- BUSINESS USER MODE VIEW (Req 50 & 59)                    -->
            <!-- ======================================================== -->
            <Grid Visibility="{Binding CurrentMode, Converter={local:ModeToVisibilityConverter}, ConverterParameter=BusinessUser}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Health Overview Card -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Presentation Health" FontWeight="Bold" FontSize="13" Foreground="#1E293B" />
                                        <TextBlock Text="{Binding ActivePresentationName}" FontSize="11" Foreground="#64748B" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding HealthScoreText}" FontWeight="Bold" FontSize="20" Foreground="{Binding HealthScoreValue, Converter={StaticResource HealthScoreToColorConv}}" />
                                </Grid>

                                <ProgressBar Height="8" Margin="0,10,0,12" Value="{Binding HealthScoreValue}" Maximum="100" Foreground="{Binding HealthScoreValue, Converter={StaticResource HealthScoreToColorConv}}" Background="#E2E8F0" />

                                <!-- Summary Stats (Req 59) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Background="#FEF2F2" CornerRadius="4" Padding="6" Margin="2">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Report.ErrorCount}" FontWeight="Bold" FontSize="15" Foreground="#DC2626" HorizontalAlignment="Center" />
                                            <TextBlock Text="Errors" FontSize="10" Foreground="#7F1D1D" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="#FFFBEB" CornerRadius="4" Padding="6" Margin="2">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Report.WarningCount}" FontWeight="Bold" FontSize="15" Foreground="#D97706" HorizontalAlignment="Center" />
                                            <TextBlock Text="Warnings" FontSize="10" Foreground="#78350F" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#F0FDF4" CornerRadius="4" Padding="6" Margin="2">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Report.PassedCount}" FontWeight="Bold" FontSize="15" Foreground="#16A34A" HorizontalAlignment="Center" />
                                            <TextBlock Text="Passed" FontSize="10" Foreground="#14532D" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="3" Background="#F8FAFC" CornerRadius="4" Padding="6" Margin="2">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Report.FixedCount}" FontWeight="Bold" FontSize="15" Foreground="#0284C7" HorizontalAlignment="Center" />
                                            <TextBlock Text="Fixed" FontSize="10" Foreground="#0369A1" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- AI Auto Layout Quick Action (Req 1, 34, 35) -->
                        <Border Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="✨ AI Auto Layout Assistant" FontWeight="Bold" FontSize="12" Foreground="#6D28D9" />
                                    <TextBlock Text="Analyzes slide semantics and recommends 3-5 visual layouts." FontSize="10.5" Foreground="#7C3AED" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="✨ Improve Slide" Style="{StaticResource PrimaryActionBtn}" Background="#7C3AED" Command="{Binding ImproveSlideCommand}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- The 7 Essential Business Quick Actions (Req 50 & 59) -->
                        <TextBlock Text="Essential Actions" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="2,0,0,6" />
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <Button Content="🔍 Check Presentation" Style="{StaticResource PrimaryActionBtn}" Command="{Binding CheckPresentationCommand}" Margin="0,0,0,6" Height="36" FontWeight="Bold" />
                                <UniformGrid Columns="2">
                                    <Button Content="🔤 Fix Formatting" Style="{StaticResource ToolBtn}" Command="{Binding FixFormattingCommand}" Height="34" />
                                    <Button Content="🌟 Apply Brand" Style="{StaticResource ToolBtn}" Command="{Binding ApplyBrandCommand}" Height="34" />
                                    <Button Content="🧹 Clean Presentation" Style="{StaticResource ToolBtn}" Command="{Binding CleanPresentationCommand}" Height="34" />
                                    <Button Content="🔎 Find &amp; Replace" Style="{StaticResource ToolBtn}" Command="{Binding ReplaceTextCommand}" Height="34" />
                                    <Button Content="📦 Insert Assets" Style="{StaticResource ToolBtn}" Command="{Binding ApplyBrandCommand}" Height="34" />
                                    <Button Content="📚 Slide Library" Style="{StaticResource ToolBtn}" Command="{Binding GenerateAgendaCommand}" Height="34" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Safe Auto-Fix (Req 53) -->
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="⚡ Safe Auto-Fix Engine" FontWeight="Bold" FontSize="12" Foreground="#15803D" />
                                    <TextBlock Text="Applies non-destructive font, alignment, and color fixes." FontSize="10.5" Foreground="#166534" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Fix Safe Issues" Style="{StaticResource PrimaryActionBtn}" Background="#16A34A" Command="{Binding FixAllSafeCommand}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Issues Feed -->
                        <TextBlock Text="Quality Findings" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="2,4,0,6" />
                        <ItemsControl ItemsSource="{Binding FilteredIssues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{Binding Severity, Converter={StaticResource SeverityToColorConv}}" CornerRadius="3" />
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <Grid>
                                                    <TextBlock Text="{Binding RuleTitle}" FontWeight="SemiBold" FontSize="11" Foreground="#1E293B" />
                                                    <TextBlock Text="{Binding SlideIndex, StringFormat='Slide {0}'}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" />
                                                </Grid>
                                                <TextBlock Text="{Binding Problem}" FontSize="10.5" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Fix" Style="{StaticResource ToolBtn}" Command="{Binding DataContext.FixIssueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" FontSize="10" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB 0: HOME DASHBOARD (Req 59)                           -->
            <!-- ======================================================== -->
            <Grid Visibility="{Binding SelectedTabIndex, Converter={local:TabIndexToVisConverter}, ConverterParameter=0}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Health Overview Card -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Presentation Health" FontWeight="Bold" FontSize="13" Foreground="#1E293B" />
                                        <TextBlock Text="{Binding ActivePresentationName}" FontSize="11" Foreground="#64748B" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding HealthScoreText}" FontWeight="Bold" FontSize="18" Foreground="{Binding HealthScoreValue, Converter={StaticResource HealthScoreToColorConv}}" />
                                </Grid>

                                <ProgressBar Height="8" Margin="0,8,0,12" Value="{Binding HealthScoreValue}" Maximum="100" Foreground="{Binding HealthScoreValue, Converter={StaticResource HealthScoreToColorConv}}" Background="#E2E8F0" />

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Background="#FEF2F2" CornerRadius="4" Padding="6" Margin="2">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Report.ErrorCount}" FontWeight="Bold" FontSize="15" Foreground="#DC2626" HorizontalAlignment="Center" />
                                            <TextBlock Text="Errors" FontSize="10" Foreground="#7F1D1D" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="#FFFBEB" CornerRadius="4" Padding="6" Margin="2">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Report.WarningCount}" FontWeight="Bold" FontSize="15" Foreground="#D97706" HorizontalAlignment="Center" />
                                            <TextBlock Text="Warnings" FontSize="10" Foreground="#78350F" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#F0FDF4" CornerRadius="4" Padding="6" Margin="2">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Report.PassedCount}" FontWeight="Bold" FontSize="15" Foreground="#16A34A" HorizontalAlignment="Center" />
                                            <TextBlock Text="Passed" FontSize="10" Foreground="#14532D" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="3" Background="#F8FAFC" CornerRadius="4" Padding="6" Margin="2">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Report.FixedCount}" FontWeight="Bold" FontSize="15" Foreground="#0284C7" HorizontalAlignment="Center" />
                                            <TextBlock Text="Fixed" FontSize="10" Foreground="#0369A1" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Quick Consistency Commands (Req 47 & 48) -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Studio Consistency Engine" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,6" />
                                <UniformGrid Columns="2" Margin="0,0,0,6">
                                    <Button Content="⚡ Make Slide Consistent" Style="{StaticResource PrimaryActionBtn}" Command="{Binding MakeSlideConsistentCommand}" Height="32" />
                                    <Button Content="🌐 Make Presentation Consistent" Style="{StaticResource ToolBtn}" Command="{Binding MakePresentationConsistentCommand}" Height="32" />
                                </UniformGrid>
                                <Button Content="🛡️ Apply All Safe Auto-Fixes" Style="{StaticResource ToolBtn}" Command="{Binding FixAllSafeCommand}" Background="#F0FDF4" Foreground="#15803D" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <!-- Scope & Scan -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Presentation Analysis Scope" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox SelectedIndex="0" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Active Slide" />
                                        <ComboBoxItem Content="Entire Presentation" />
                                    </ComboBox>
                                    <Button Grid.Column="1" Content="🔍 Scan Now" Style="{StaticResource PrimaryActionBtn}" Command="{Binding AnalyzeCommand}" Margin="6,0,0,0" />
                                </Grid>
                                <UniformGrid Columns="2">
                                    <Button Content="🔤 Normalize Typography" Style="{StaticResource ToolBtn}" Command="{Binding FixFormattingCommand}" />
                                    <Button Content="🧹 Clean Ghost Shapes" Style="{StaticResource ToolBtn}" Command="{Binding CleanupSlideCommand}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB 1: DESIGN & INSPECTOR (Req 49)                       -->
