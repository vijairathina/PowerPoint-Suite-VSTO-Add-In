                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Expert Diagnostics &amp; Rule Engine (Req 51 &amp; 52)" FontWeight="Bold" FontSize="12" Foreground="#1E293B" Margin="0,0,0,6" />
                                <TextBlock Text="Extensible IQualityRule engine with declarative custom rules &amp; design tokens." FontSize="10" Foreground="#64748B" Margin="0,0,0,8" />
                                <UniformGrid Columns="2">
                                    <Button Content="💾 Export Tokens JSON" Style="{StaticResource ToolBtn}" Command="{Binding ExportReportJsonCommand}" />
                                    <Button Content="📋 Command Palette" Style="{StaticResource ToolBtn}" Command="{Binding AnalyzeCommand}" ToolTip="Search and trigger all 60+ Studio commands" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB 14: AI AUTO LAYOUT ENGINE (Req 1-38)                 -->
            <!-- ======================================================== -->
            <Grid Visibility="{Binding SelectedTabIndex, Converter={local:TabIndexToVisConverter}, ConverterParameter=14}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,12">
                        <!-- AI Studio Banner & Actions -->
                        <Border Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✨" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="AI Auto Layout Studio" FontWeight="Bold" FontSize="14" Foreground="#5B21B6" VerticalAlignment="Center" />
                                        <Border Background="#EDE9FE" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Local • Privacy Preserving" FontSize="9.5" FontWeight="SemiBold" Foreground="#6D28D9" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Analyzes semantic content and recommends visual PowerPoint layouts without losing content." FontSize="10.5" Foreground="#6D28D9" Margin="0,3,0,8" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Action Buttons -->
                                <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,6">
                                    <Button Content="⚡ Analyze Slide" Style="{StaticResource PrimaryActionBtn}" Command="{Binding AILayoutAnalyzeCommand}" Background="#7C3AED" ToolTip="Decompose content hierarchy and generate 3-5 visual layout suggestions" />
                                    <Button Content="✨ Improve Slide" Style="{StaticResource ToolBtn}" Command="{Binding ImproveSlideCommand}" ToolTip="One-click analyze, diagnose issues, and propose layouts" />
                                </UniformGrid>
                                <UniformGrid Grid.Row="2" Columns="2">
                                    <Button Content="👔 Make Professional" Style="{StaticResource ToolBtn}" Command="{Binding MakeSlideProfessionalCommand}" ToolTip="Polishes typography, margins, and harmonizes layouts" />
                                    <Button Content="↺ Re-analyze" Style="{StaticResource ToolBtn}" Command="{Binding AILayoutAnalyzeCommand}" />
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <!-- CURRENT SLIDE ANALYSIS CARD -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="CURRENT SLIDE ANALYSIS" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,6" />
                                
                                <!-- Empty state when not yet analyzed -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="12"
                                        Visibility="{Binding CurrentSlideAnalysis, Converter={local:NullToVisConverter}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🔍 No slide analyzed yet" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" />
                                        <TextBlock Text="Click 'Analyze Slide' above to evaluate content structure, text density, and charts." FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Analysis Results -->
                                <StackPanel Visibility="{Binding CurrentSlideAnalysis, Converter={local:NotNullToVisConverter}}">
                                    <!-- Title & Content Type -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding CurrentSlideAnalysis.SlideTitle, StringFormat='Title: &quot;{0}&quot;'}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CurrentSlideAnalysis.ContentTypeReason}" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding CurrentSlideAnalysis.DetectedContentType}" FontSize="10" FontWeight="Bold" Foreground="#4338CA" />
                                        </Border>
                                    </Grid>

                                    <!-- Content metrics chips -->
                                    <WrapPanel Margin="0,0,0,8">
                                        <Border Background="#F1F5F9" CornerRadius="3" Padding="5,2" Margin="0,0,4,4">
                                            <TextBlock Text="{Binding CurrentSlideAnalysis.TotalWordCount, StringFormat='📝 {0} words'}" FontSize="10" Foreground="#334155" />
                                        </Border>
                                        <Border Background="#F1F5F9" CornerRadius="3" Padding="5,2" Margin="0,0,4,4">
                                            <TextBlock Text="{Binding CurrentSlideAnalysis.TotalBulletCount, StringFormat='• {0} bullets'}" FontSize="10" Foreground="#334155" />
                                        </Border>
                                        <Border Background="#F1F5F9" CornerRadius="3" Padding="5,2" Margin="0,0,4,4">
                                            <TextBlock Text="{Binding CurrentSlideAnalysis.TotalImagesCount, StringFormat='🖼️ {0} images'}" FontSize="10" Foreground="#334155" />
                                        </Border>
                                        <Border Background="#F1F5F9" CornerRadius="3" Padding="5,2" Margin="0,0,4,4">
                                            <TextBlock Text="{Binding CurrentSlideAnalysis.TotalChartsCount, StringFormat='📊 {0} charts'}" FontSize="10" Foreground="#334155" />
                                        </Border>
                                        <Border Background="#F1F5F9" CornerRadius="3" Padding="5,2" Margin="0,0,4,4">
                                            <TextBlock Text="{Binding CurrentSlideAnalysis.TotalTablesCount, StringFormat='📋 {0} tables'}" FontSize="10" Foreground="#334155" />
                                        </Border>
                                    </WrapPanel>

                                    <!-- Detected Issues / Density Warnings -->
                                    <ItemsControl ItemsSource="{Binding CurrentSlideAnalysis.DetectedIssues}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,0,3">
                                                    <TextBlock Text="{Binding StringFormat='⚠ {0}'}" FontSize="10" Foreground="#92400E" TextWrapping="Wrap" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- SUGGESTED LAYOUTS (3-5 options) -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SUGGESTED LAYOUTS (3–5)" FontWeight="Bold" FontSize="11" Foreground="#475569" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding SuggestedLayouts.Count, StringFormat='{}{0} alternatives'}" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" />
                                </Grid>

                                <ListBox ItemsSource="{Binding SuggestedLayouts}" SelectedItem="{Binding SelectedLayoutSuggestion, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,6" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="bd" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="#7C3AED" />
                                                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5" />
                                                                <Setter TargetName="bd" Property="Background" Value="#FAF5FF" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="#C084FC" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Thumbnail / Icon -->
                                                <Border Grid.Column="0" Width="38" Height="38" Background="#EDE9FE" CornerRadius="6" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding IconSymbol}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                
                                                <!-- Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding OptionNumber, StringFormat='Option {0}: '}" FontWeight="Bold" FontSize="11.5" Foreground="#7C3AED" />
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="11.5" Foreground="#1E293B" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Reasoning}" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxHeight="30" />
                                                </StackPanel>

                                                <!-- Score Badges -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0,0,0">
                                                    <Border Background="#DCFCE7" CornerRadius="3" Padding="4,1" Margin="0,0,0,2">
                                                        <TextBlock Text="100% Content" FontSize="9" FontWeight="Bold" Foreground="#15803D" />
                                                    </Border>
                                                    <Border Background="#F1F5F9" CornerRadius="3" Padding="4,1">
                                                        <TextBlock Text="{Binding ContentDensity}" FontSize="9" Foreground="#475569" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- SELECTED LAYOUT DETAILS & ACTIONS -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"
                                Visibility="{Binding SelectedLayoutSuggestion, Converter={local:NotNullToVisConverter}}">
                            <StackPanel>
                                <TextBlock Text="SELECTED LAYOUT DETAILS &amp; AUDIT" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,6" />
                                
                                <TextBlock Text="{Binding SelectedLayoutSuggestion.Title, StringFormat='Target Layout: {0}'}" FontWeight="Bold" FontSize="13" Foreground="#7C3AED" />
                                <TextBlock Text="{Binding SelectedLayoutSuggestion.Reasoning}" FontSize="10.5" Foreground="#334155" TextWrapping="Wrap" Margin="0,4,0,8" />

                                <!-- Quality Score Grid -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                                    <UniformGrid Columns="3">
                                        <StackPanel Margin="2">
                                            <TextBlock Text="Hierarchy" FontSize="9.5" Foreground="#64748B" />
                                            <TextBlock Text="{Binding SelectedLayoutSuggestion.QualityScore.Hierarchy}" FontWeight="Bold" FontSize="11" Foreground="#15803D" />
                                        </StackPanel>
                                        <StackPanel Margin="2">
                                            <TextBlock Text="Spacing" FontSize="9.5" Foreground="#64748B" />
                                            <TextBlock Text="{Binding SelectedLayoutSuggestion.QualityScore.Spacing}" FontWeight="Bold" FontSize="11" Foreground="#15803D" />
                                        </StackPanel>
                                        <StackPanel Margin="2">
                                            <TextBlock Text="Readability" FontSize="9.5" Foreground="#64748B" />
                                            <TextBlock Text="{Binding SelectedLayoutSuggestion.QualityScore.Readability}" FontWeight="Bold" FontSize="11" Foreground="#15803D" />
                                        </StackPanel>
                                        <StackPanel Margin="2">
                                            <TextBlock Text="Brand Match" FontSize="9.5" Foreground="#64748B" />
                                            <TextBlock Text="{Binding SelectedLayoutSuggestion.QualityScore.BrandConsistency}" FontWeight="Bold" FontSize="11" Foreground="#15803D" />
                                        </StackPanel>
                                        <StackPanel Margin="2">
                                            <TextBlock Text="Preservation" FontSize="9.5" Foreground="#64748B" />
                                            <TextBlock Text="{Binding SelectedLayoutSuggestion.QualityScore.ContentPreservationPct, StringFormat='{}{0:F0}%'}" FontWeight="Bold" FontSize="11" Foreground="#15803D" />
                                        </StackPanel>
                                        <StackPanel Margin="2">
                                            <TextBlock Text="Complexity" FontSize="9.5" Foreground="#64748B" />
                                            <TextBlock Text="{Binding SelectedLayoutSuggestion.QualityScore.Complexity}" FontWeight="Bold" FontSize="11" Foreground="#334155" />
                                        </StackPanel>
                                    </UniformGrid>
                                </Border>

                                <!-- Apply Buttons -->
                                <UniformGrid Columns="2" Margin="0,0,0,4">
                                    <Button Content="⚡ Apply Layout" Style="{StaticResource PrimaryActionBtn}" Command="{Binding ApplySelectedLayoutCommand}" Background="#16A34A" ToolTip="Transform active slide shapes into this layout (reversible with Undo)" />
                                    <Button Content="📄 Apply as New Slide" Style="{StaticResource ToolBtn}" Command="{Binding ApplySelectedLayoutAsNewSlideCommand}" ToolTip="Duplicates active slide and applies new layout, keeping original untouched" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- REFERENCE SLIDE MODE ("MAKE IT LIKE THIS" - Req 11, 36) -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="REFERENCE SLIDE MODE (Req 11, 36)" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBlock Text="Extracts the visual layout, grid, and typography from a reference slide and applies it to the active slide without copying content." FontSize="10" Foreground="#64748B" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ref Slide #:" VerticalAlignment="Center" FontSize="11" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" Text="{Binding ReferenceSlideIndex, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="4,3" />
                                    <Button Grid.Column="2" Content="🎨 Make It Like This" Style="{StaticResource ToolBtn}" Command="{Binding MakeItLikeThisCommand}" Margin="8,0,0,0" ToolTip="Apply visual structure of reference slide to current slide" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- NARRATIVE SEQUENCE HARMONIZATION (Req 20, 21, 37) -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="PRESENTATION SEQUENCE HARMONIZATION (Req 20, 21, 37)" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBlock Text="Aligns visual hierarchy, margins, and card templates across neighboring sequence slides." FontSize="10" Foreground="#64748B" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <Button Content="🔄 Make These Slides Consistent" Style="{StaticResource ToolBtn}" Command="{Binding MakeTheseSlidesConsistentCommand}" ToolTip="Harmonize selected slides or surrounding 5 slides to a cohesive narrative style" />
                            </StackPanel>
                        </Border>

                        <!-- PRIVACY & SAFETY BADGE -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🛡️ 100% Native Interop • Reversible Undo Snapshots • Zero Cloud Leakage" FontSize="9.5" Foreground="#64748B" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ── STATUS BAR & UNDO ── -->
        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="↩ Undo" Style="{StaticResource ToolBtn}" Command="{Binding UndoCommand}" FontSize="10.5" Padding="8,2" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
