<Window x:Class="OneAssist.ImageEditor.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Editor Settings" 
        Width="520" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F6F8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="180"/>
        </Style>

        <Style x:Key="ShortcutBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#D24726"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B83A1D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,14">
            <StackPanel>
                <TextBlock Text="Image Editor Settings" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock Text="Customize keyboard shortcuts, defaults, and preferences." FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,10">
            <StackPanel>

                <!-- ── Keyboard Shortcuts ─────────────────────────── -->
                <TextBlock Text="KEYBOARD SHORTCUTS" Style="{StaticResource SectionHeader}"/>
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="Click a shortcut field and type a new combination (e.g. Ctrl+B)." FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,10"/>

                        <!-- Actions -->
                        <DockPanel Margin="0,4">
                            <TextBlock Text="Undo" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtUndo" Style="{StaticResource ShortcutBox}" PreviewKeyDown="OnShortcutKeyDown" Tag="Undo"/>
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="Redo" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtRedo" Style="{StaticResource ShortcutBox}" PreviewKeyDown="OnShortcutKeyDown" Tag="Redo"/>
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="Apply to PowerPoint" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtApply" Style="{StaticResource ShortcutBox}" PreviewKeyDown="OnShortcutKeyDown" Tag="Apply"/>
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="Remove Background" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtRemoveBg" Style="{StaticResource ShortcutBox}" PreviewKeyDown="OnShortcutKeyDown" Tag="RemoveBg"/>
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="Reload Image from PowerPoint" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtReload" Style="{StaticResource ShortcutBox}" PreviewKeyDown="OnShortcutKeyDown" Tag="Reload"/>
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="Toggle Before / After" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtToggleCompare" Style="{StaticResource ShortcutBox}" PreviewKeyDown="OnShortcutKeyDown" Tag="ToggleCompare"/>
                        </DockPanel>

                        <Separator Margin="0,8" Background="#F3F4F6"/>
                        <TextBlock Text="Tool Switcher Keys" FontSize="11" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>

                        <DockPanel Margin="0,4">
                            <TextBlock Text="Remove Background tool" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtToolRemoveBg" Style="{StaticResource ShortcutBox}" PreviewKeyDown="OnShortcutKeyDown" Tag="ToolRemoveBg"/>
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="Mark &amp; Remove tool" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtToolMarkRemove" Style="{StaticResource ShortcutBox}" PreviewKeyDown="OnShortcutKeyDown" Tag="ToolMarkRemove"/>
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="Eraser tool" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtToolEraser" Style="{StaticResource ShortcutBox}" PreviewKeyDown="OnShortcutKeyDown" Tag="ToolEraser"/>
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="Background tool" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtToolBackground" Style="{StaticResource ShortcutBox}" PreviewKeyDown="OnShortcutKeyDown" Tag="ToolBackground"/>
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="Crop tool" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtToolCrop" Style="{StaticResource ShortcutBox}" PreviewKeyDown="OnShortcutKeyDown" Tag="ToolCrop"/>
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="Adjust tool" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtToolAdjust" Style="{StaticResource ShortcutBox}" PreviewKeyDown="OnShortcutKeyDown" Tag="ToolAdjust"/>
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="Transform tool" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtToolTransform" Style="{StaticResource ShortcutBox}" PreviewKeyDown="OnShortcutKeyDown" Tag="ToolTransform"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ── Background Removal Defaults ───────────────── -->
                <TextBlock Text="BACKGROUND REMOVAL DEFAULTS" Style="{StaticResource SectionHeader}"/>
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="14,10">
                    <StackPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="Default Tolerance" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtBgTolerance" Style="{StaticResource ShortcutBox}" Width="80"/>
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="Default Feather" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtBgFeather" Style="{StaticResource ShortcutBox}" Width="80"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ── Brush Defaults ────────────────────────────── -->
                <TextBlock Text="BRUSH DEFAULTS" Style="{StaticResource SectionHeader}"/>
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="14,10">
                    <StackPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="Default Brush Size" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtBrushSize" Style="{StaticResource ShortcutBox}" Width="80"/>
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="Default Brush Hardness" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtBrushHardness" Style="{StaticResource ShortcutBox}" Width="80"/>
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="Default Brush Opacity" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtBrushOpacity" Style="{StaticResource ShortcutBox}" Width="80"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ── Behavior Preferences ──────────────────────── -->
                <TextBlock Text="BEHAVIOR PREFERENCES" Style="{StaticResource SectionHeader}"/>
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="14,10">
                    <StackPanel>
                        <CheckBox x:Name="ChkAutoLoad" Content="Auto-load image when a picture is selected in PowerPoint" Margin="0,4" FontSize="11" Foreground="#374151"/>
                        <CheckBox x:Name="ChkAutoDetect" Content="Detect selection when task pane becomes visible" Margin="0,4" FontSize="11" Foreground="#374151"/>
                    </StackPanel>
                </Border>

                <StackPanel Height="20"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button Content="Reset to Defaults" Style="{StaticResource SecButton}" Click="OnResetClick" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource SecButton}" Margin="0,0,8,0" Click="OnCancelClick"/>
                    <Button Content="Save Settings" Style="{StaticResource PrimaryButton}" Click="OnSaveClick"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
